+###########################################################
+################# Step Explosion Endpoint #################
+###########################################################
+
+class ExplodeStepsRequest(BaseModel):
+    steps: List[str]
+
+class ExplodeStepResult(BaseModel):
+    original: str
+    exploded: List[str]
+    triples_per_step: List[List[Any]]
+
+class ExplodeStepsResponse(BaseModel):
+    results: List[ExplodeStepResult]
+
+@router.post("/api/v1/steps/explode", response_model=ExplodeStepsResponse)
+async def explode_steps_endpoint(req: ExplodeStepsRequest):
+    """
+    Takes a list of step strings. Returns per-step results: for each input step,
+    the list of output steps (length 1 if no explosion, length N if exploded),
+    plus the triples for each sub-step.
+    Called by the Spring Boot StepExplosionService after test cases are saved.
+    """
+    if not req.steps:
+        return ExplodeStepsResponse(results=[])
+    try:
+        enriched = await extract_triples_for_steps(req.steps)
+        groups = await explode_steps_grouped(enriched)
+        results = [
+            ExplodeStepResult(
+                original=req.steps[i],
+                exploded=[s["step"] for s in groups[i]],
+                triples_per_step=[s.get("triples", []) for s in groups[i]]
+            )
+            for i in range(len(req.steps))
+        ]
+        return ExplodeStepsResponse(results=results)
+    except Exception as e:
+        raise HTTPException(status_code=500, detail=f"Step explosion failed: {e}")
