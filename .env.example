# Copy to .env for local development, or set these as environment
# variables directly in your deployment platform (e.g. Railway).
# Never commit the real .env file — it is already gitignored.

# Required — src/api/app.py's default execute is call_shakti
# (src/pipeline/shakti_execute.py), which reads this at request time.
SHAKTI_API_KEY=

# Not required for deployment. Only used by run_full_pipeline.py, a local
# CLI script that is not part of the deployed API.
GEMINI_API_KEY=

# Required for GitHub OAuth (Milestone 2 — /github/login, /github/callback).
# Register an OAuth App at https://github.com/settings/developers; its
# "Authorization callback URL" must exactly match GITHUB_OAUTH_REDIRECT_URI
# below.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8020/github/callback

# Where /github/callback redirects the browser after login completes, and
# the one CORS origin (besides the deployed playground/) allowed to send
# credentialed requests to this API.
FRONTEND_URL=http://localhost:5173

# Optional, defaults to true. Set to false only if a local HTTP setup
# can't receive the session cookie (SameSite=None requires Secure in most
# browsers — Chrome/Edge carve out an explicit http://localhost exception,
# but not every browser does).
SESSION_COOKIE_SECURE=true
