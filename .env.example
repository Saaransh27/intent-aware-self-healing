# Copy to .env for local development, or set these as environment
# variables directly in your deployment platform (e.g. Railway).
# Never commit the real .env file — it is already gitignored.

# Required — src/api/app.py's default execute is call_shakti
# (src/pipeline/shakti_execute.py), which reads this at request time.
SHAKTI_API_KEY=

# Not required for deployment. Only used by run_full_pipeline.py, a local
# CLI script that is not part of the deployed API.
GEMINI_API_KEY=
